
# Creates the Linux Web App through AzAPI so creation-time hostname settings and sidecar containers can be configured.

# Retrieves the active Azure subscription ID to construct the Resource Group ID.
data "azurerm_client_config" "current" {}

locals {
  resource_group_id = "/subscriptions/${data.azurerm_client_config.current.subscription_id}/resourceGroups/${var.resource_group_name}"
}


resource "azapi_resource" "app_service" {
  type      = "Microsoft.Web/sites@2024-04-01"
  name      = var.app_service_name
  parent_id = local.resource_group_id
  location  = var.selected_region

  identity {
    type = "SystemAssigned"
  }

  body = {
    #kind = "app,linux,container"
    kind = "app,linux"

    properties = {
      serverFarmId = var.service_plan_id
      reserved     = true # Required for Linux Web Appss

      httpsOnly = true

      # Requests a tenant-wide unique default hostname at creation.
      autoGeneratedDomainNameLabelScope = "TenantReuse"

      siteConfig = {
        alwaysOn = false

        # Enables the App Service sidecar-container model.
        linuxFxVersion = "SITECONTAINERS"

        # Retains the existing App Service application settings.
        #app setting temporarily removed to break the App Service dependency cycle.
      }
    }

    tags = {
      environment = var.environment
    }
  }

  response_export_values = [
    "identity",
    "properties.defaultHostName"
  ]
}

# Defines the existing application image as the main site container.
resource "azapi_resource" "main_container" {
  type      = "Microsoft.Web/sites/sitecontainers@2024-04-01"
  name      = "main"
  parent_id = azapi_resource.app_service.id

  body = {
    properties = {
      #image  = "${var.app_service_container_image}:1.0.0"
      image  = "${var.registry_server_url}/${var.app_service_container_image}:1.0.0"
      isMain = true
      authType = "Anonymous"
      targetPort = "8080"
    }
  }
}



# Creates optional additional containers attached to the main App Service.
resource "azapi_resource" "sidecar_container" {
  for_each = var.sidecar_containers

  type      = "Microsoft.Web/sites/sitecontainers@2024-04-01"
  name      = each.key
  parent_id = azapi_resource.app_service.id

  body = {
    properties = {
      image   = each.value.image
      isMain  = false
      authType = "Anonymous"

      targetPort = each.value.target_port

      environmentVariables = [
        for name, value in each.value.environment_variables : {
          name  = name
          value = value
        }
      ]
    }
  }
}



# Updates App Service application settings without managing the configuration endpoint's deletion lifecycle.
resource "azapi_update_resource" "app_settings" {
  type        = "Microsoft.Web/sites/config@2024-04-01"
  resource_id = "${azapi_resource.app_service.id}/config/appsettings"

  body = {
    properties = local.app_settings
  }
}
