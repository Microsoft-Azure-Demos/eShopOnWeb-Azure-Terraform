variable  app_service_name {
  description = "The name of the app service."
  type        = string
  default     = "eshop-app-service"
} 

variable  environment {
  description = "The environment for the app service."
  type        = string
  default     = "dev"
}

variable  app_service_container_image {
  description = "The container image for the app service."
  type        = string
  default     = "microsoft/eshoponweb:latest"
}

variable "service_plan_id" {
  description = "ID of the shared App Service Plan"
  type        = string
}


# Accepts application settings generated by the root Terraform configuration.
variable "app_settings" {
  description = "Application settings for the Linux Web App"
  type        = map(string)
  default     = {}
}

variable "resource_group_name" {
  description = "The name of the resource group."
  type        = string
}

variable "selected_region" {
  description = "The location of the resource group."
  type        = string
}



# Defines optional sidecar containers for the App Service.
variable "sidecar_containers" {
  description = "Additional sidecar containers attached to the App Service."

  type = map(object({
    image                 = string
    target_port           = optional(string)
    environment_variables = optional(map(string), {})
  }))

  default = {}
}


variable "registry_server_url" {
  description = "The URL of the container registry."
  type        = string
  default     = "index.docker.io"
}

